generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  password        String
  resetToken      String?
  resetTokenExpiry DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  subscriptions Subscription[]
  auditLogs     AuditLog[]

  @@map("users")
}

model Subscription {
  id            String   @id @default(cuid())
  name          String
  price         Float
  currency      String   @default("USD")
  frequency     String   @default("monthly")
  category      String
  paymentMethod String
  status        String   @default("active")
  startDate     DateTime
  renewalDate   DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  auditLogs AuditLog[]

  @@index([userId])
  @@map("subscriptions")
}

model AuditLog {
  id             String   @id @default(cuid())
  action         String
  entity         String
  entityId       String
  oldValues      Json?
  newValues      Json?
  userId         String?
  createdAt      DateTime @default(now())

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  subscription Subscription? @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@index([entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}
